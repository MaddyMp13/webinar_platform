Options -Indexes
DirectoryIndex index.html

# Serve only public page/assets and the PHP API entry point.
# SQL, credentials, database files, backups, source tests, and raw videos stay private.
RewriteEngine On
RewriteRule ^(?:index\.html|first\.html|webinar\.html|dashboard\.html|transcripts\.html|styles\.css|dashboard\.css|transcripts\.css|script\.js|dashboard\.js|transcripts\.js|backend\.js|registration\.js|registration-rules\.js|playback\.js|chat\.js|Google-Logo-Tech-Company\.png|api/index\.php)?$ - [END]
RewriteRule ^ - [F,L]
